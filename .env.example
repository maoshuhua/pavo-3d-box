# Copy to .env; fill in your own provider values locally. Never commit .env.
# Never put API keys or provider configuration in VITE_* variables.
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
# Optional mappings for the UI modes; otherwise AGENT_MODEL is used.
AGENT_MODEL_G6=
AGENT_MODEL_DV4=
AGENT_PORT=8787
AGENT_DATA_DIR=.agent-data
AGENT_RUN_TIMEOUT_MS=1800000
AGENT_MODEL_TIMEOUT_MS=180000
AGENT_RECURSION_LIMIT=100
AGENT_MAX_BUILD_PASSES=3
VITE_AGENT_URL=http://127.0.0.1:8787
# Optional: path to an installed Chrome/Edge executable.
# AGENT_BROWSER_EXECUTABLE=
