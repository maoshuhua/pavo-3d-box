# Copy to .env. Keep credentials on the local server, never in VITE_* variables.
AGENT_BASE_URL=https://your-provider.example/v1
AGENT_API_KEY=
# Comma-separated model names sharing AGENT_BASE_URL and AGENT_API_KEY.
# The first model is the default. Restart the Agent service after changing this list.
AGENT_MODELS=
AGENT_PORT=8787
AGENT_DATA_DIR=.agent-data
AGENT_RUN_TIMEOUT_MS=900000
AGENT_MODEL_TIMEOUT_MS=180000
# Graph steps per run (50-5000); a reserved tail lets the agent stop before exhaustion.
AGENT_RECURSION_LIMIT=500
AGENT_MAX_BUILD_PASSES=3
VITE_AGENT_URL=http://127.0.0.1:8787
# Optional: installed Edge/Chrome or Playwright Chromium executable
# AGENT_BROWSER_EXECUTABLE=C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe

